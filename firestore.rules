rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is an admin
    function isAdmin() {
      return isAuthenticated();
    }

    // --- Collections ---

    // 1. Articles
    match /articles/{articleId} {
      // Public can read if published
      allow read: if resource.data.isPublished == true || isAdmin();
      // Only authenticated admins can write (server-side Admin SDK bypasses this)
      allow write: if isAdmin();
    }

    // 2. Magazines
    match /magazines/{magazineId} {
      // Public can read if published
      allow read: if resource.data.isPublished == true || isAdmin();
      // Only admins can write
      allow write: if isAdmin();

      // Subcollection: pages (for multilingual AI translations)
      match /pages/{pageNumber} {
        allow read: if true; // Public can read translations
        allow write: if isAdmin(); // Only admins can write translations
      }
    }

    // 3. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Advertisements
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Media
    match /media/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 6. Global Configuration / Metadata
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
