rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null;
    }

    // Articles
    match /articles/{articleId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Magazines
    match /magazines/{magazineId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
      match /pages/{pageNumber} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Advertisements
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media
    match /media/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mobile App CMS Collections (app-prefixed)
    match /app_magazines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_reels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_sponsors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Base collections used by mobile app
    match /magazines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sponsors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App notifications
    match /app_notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
